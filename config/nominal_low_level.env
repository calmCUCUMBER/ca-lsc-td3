# Frozen PX4 fallback configuration for all experiments.  A fresh external
# transition-allocation lambda overrides the MC/FW attitude weights; these
# airspeed thresholds remain the fail-safe path after command loss and must
# never be derived from VA_TARGET_MPS.
NOMINAL_VT_ARSP_BLEND=8.0
NOMINAL_VT_ARSP_TRANS=13.0
NOMINAL_FW_AIRSPD_MIN=12.0
NOMINAL_FW_AIRSPD_TRIM=15.0
NOMINAL_FW_AIRSPD_MAX=20.0
