+void
+Standard::publish_pitch_control_weights()
+{
+	const hrt_abstime now = hrt_absolute_time();
+	const float mc_weight = math::constrain(_mc_pitch_weight, 0.0f, 1.0f);
+
+	normalized_unsigned_setpoint_s mc_status{};
+	mc_status.timestamp = now;
+	mc_status.normalized_setpoint = mc_weight;
+	_mc_pitch_weight_pub.publish(mc_status);
+
+	normalized_unsigned_setpoint_s fw_status{};
+	fw_status.timestamp = now;
+	fw_status.normalized_setpoint = 1.0f - mc_weight;
+	_fw_pitch_weight_pub.publish(fw_status);
+}
+
+void
+Standard::apply_lambda_attitude_allocation()
+{
+	if (_vtol_mode != vtol_mode::TRANSITION_TO_FW
+	    || !_lift_unloading_command_valid) {
+		return;
+	}
+
+	const float lambda_0 = math::constrain(_param_vt_unld_w0.get(), 0.0f, 1.0f);
+	const float lambda_1 = math::constrain(_param_vt_unld_w1.get(), 0.0f, 1.0f);
+	float fw_weight = _lift_unloading_exec;
+
+	if (lambda_1 > lambda_0 + FLT_EPSILON) {
+		fw_weight = (_lift_unloading_exec - lambda_0) / (lambda_1 - lambda_0);
+	}
+
+	fw_weight = math::constrain(fw_weight, 0.0f, 1.0f);
+	const float mc_weight = 1.0f - fw_weight;
+
+	// Lambda is the single transition-allocation variable while the external
+	// command is active.  Do not leave PX4's airspeed schedule competing with
+	// it on any attitude axis.  The collective path below still uses the
+	// physical unloading value (1-lambda), not the remapped attitude weight.
+	_mc_roll_weight = mc_weight;
+	_mc_pitch_weight = mc_weight;
+	_mc_yaw_weight = mc_weight;
+	_mc_throttle_weight = 1.0f - _lift_unloading_exec;
+}
+
+void
+Standard::update_lift_rotor_unloading()
+{
+	const hrt_abstime now = hrt_absolute_time();
+	const bool forward_transition = _vtol_mode == vtol_mode::TRANSITION_TO_FW;
+	normalized_unsigned_setpoint_s command{};
+
+	if (_lift_unloading_setpoint_sub.update(&command)) {
+		const bool input_valid = PX4_ISFINITE(command.normalized_setpoint)
+					 && command.normalized_setpoint >= 0.0f
+					 && command.normalized_setpoint <= 1.0f
+					 && command.timestamp <= now + 100_ms
+					 && command.timestamp + 500_ms >= now
+					 && forward_transition;
+
+		if (input_valid) {
+			_lift_unloading_target = command.normalized_setpoint;
+			_last_lift_unloading_command = now;
+			_lift_unloading_command_valid = true;
+			_lift_unloading_override_engaged = true;
+
+		} else {
+			// Reject malformed, out-of-range, or stale input.  In particular,
+			// never clamp a large positive value into a full-unload command.
+			_lift_unloading_target = 0.0f;
+			_lift_unloading_exec = 0.0f;
+			_lift_unloading_command_valid = false;
+		}
+	}
+
+	const bool command_fresh = _lift_unloading_command_valid
+				   && now <= _last_lift_unloading_command + 500_ms;
+	if (!forward_transition) {
+		_lift_unloading_target = 0.0f;
+		_lift_unloading_exec = 0.0f;
+		_lift_unloading_command_valid = false;
+		_lift_unloading_override_engaged = false;
+
+	} else if (!command_fresh || _vtol_vehicle_status->fixed_wing_system_failure) {
+		// Loss of the companion command is fail-safe: restore rotor support
+		// immediately instead of waiting for a normal rate limiter.
+		_lift_unloading_target = 0.0f;
+		_lift_unloading_exec = 0.0f;
+		_lift_unloading_command_valid = false;
+
+	} else {
+		const float dt = _last_lift_unloading_update == 0
+				 ? 0.0f
+				 : math::constrain((now - _last_lift_unloading_update) * 1e-6f, 0.0f, 0.1f);
+		constexpr float unload_rate = 0.25f;  // lambda / s
+		constexpr float restore_rate = 2.0f;  // lambda / s
+
+		if (_lift_unloading_target > _lift_unloading_exec) {
+			_lift_unloading_exec = math::min(
+				_lift_unloading_target,
+				_lift_unloading_exec + unload_rate * dt);
+
+		} else {
+			_lift_unloading_exec = math::max(
+				_lift_unloading_target,
+				_lift_unloading_exec - restore_rate * dt);
+		}
+	}
+
+	_last_lift_unloading_update = now;
+
+	normalized_unsigned_setpoint_s status{};
+	status.timestamp = now;
+
+	if (_lift_unloading_override_engaged && forward_transition) {
+		status.normalized_setpoint = _lift_unloading_exec;
+
+	} else if (_vtol_mode == vtol_mode::MC_MODE) {
+		status.normalized_setpoint = 0.0f;
+
+	} else if (_vtol_mode == vtol_mode::FW_MODE) {
+		status.normalized_setpoint = 1.0f;
+
+	} else {
+		status.normalized_setpoint = math::constrain(1.0f - _mc_throttle_weight, 0.0f, 1.0f);
+	}
+
+	_lift_unloading_status_pub.publish(status);
+
+	normalized_unsigned_setpoint_s active{};
+	active.timestamp = now;
+	active.normalized_setpoint =
+		(_lift_unloading_command_valid && forward_transition) ? 1.0f : 0.0f;
+	_lift_unloading_active_pub.publish(active);
+}
+
+void
+Standard::update_pusher_throttle_override()
+{
+	const hrt_abstime now = hrt_absolute_time();
+	const bool forward_transition = _vtol_mode == vtol_mode::TRANSITION_TO_FW;
+	normalized_unsigned_setpoint_s command{};
+
+	if (_pusher_throttle_setpoint_sub.update(&command)) {
+		const bool input_valid = PX4_ISFINITE(command.normalized_setpoint)
+					 && command.normalized_setpoint >= 0.0f
+					 && command.normalized_setpoint <= 1.0f
+					 && command.timestamp <= now + 100_ms
+					 && command.timestamp + 500_ms >= now
+					 && forward_transition
+					 && _param_vt_unld_test_en.get();
+
+		if (input_valid) {
+			_pusher_throttle_target = command.normalized_setpoint;
+			_last_pusher_throttle_command = now;
+			_pusher_throttle_command_valid = true;
+
+		} else {
+			_pusher_throttle_command_valid = false;
+		}
+	}
+
+	const bool command_fresh = _pusher_throttle_command_valid
+				   && now <= _last_pusher_throttle_command + 500_ms;
+	_pusher_throttle_override_active =
+		forward_transition
+		&& _param_vt_unld_test_en.get()
+		&& command_fresh
+		&& !_vtol_vehicle_status->fixed_wing_system_failure;
+
+	if (_pusher_throttle_override_active) {
+		_pusher_throttle = math::constrain(_pusher_throttle_target, 0.0f, 1.0f);
+	}
+
+	if (!forward_transition) {
+		_pusher_throttle_target = 0.0f;
+		_pusher_throttle_command_valid = false;
+		_pusher_throttle_override_active = false;
+	}
+
+	normalized_unsigned_setpoint_s status{};
+	status.timestamp = now;
+	status.normalized_setpoint = math::constrain(_pusher_throttle, 0.0f, 1.0f);
+	_pusher_throttle_status_pub.publish(status);
+
+	normalized_unsigned_setpoint_s active{};
+	active.timestamp = now;
+	active.normalized_setpoint = _pusher_throttle_override_active ? 1.0f : 0.0f;
+	_pusher_throttle_active_pub.publish(active);
+}
