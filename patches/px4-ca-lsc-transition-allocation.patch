  * @group VTOL Attitude Control
  */
 PARAM_DEFINE_FLOAT(VT_PSHER_SLEW, 0.33f);
+
+/**
+ * Hold standard VTOL in front-transition while an external unloading command is active
+ *
+ * This is a simulation/identification mode for controlled lift-rotor unloading
+ * tests.  When enabled, automatic completion to fixed-wing is delayed only
+ * while a fresh, valid external unloading command is actively controlling the
+ * collective path.  Command loss, invalid input, a fixed-wing failure, or the
+ * normal transition timeout retains the existing PX4 recovery behavior.
+ *
+ * @boolean
+ * @reboot_required true
+ * @group VTOL Attitude Control
+ */
+PARAM_DEFINE_INT32(VT_UNLD_TEST_EN, 0);
+
+/**
+ * Controlled-unloading altitude-to-pitch proportional gain
+ *
+ * During VT_UNLD_TEST_EN front-transition holds, the normal PX4 transition
+ * task fixes pitch at FW_PSP_OFF and does not run a fixed-wing altitude loop.
+ * This gain converts NED altitude error into a pitch correction so the wing
+ * can reject excess lift while lambda and airspeed are held for system
+ * identification. It has no effect on normal VTOL transitions.
+ *
+ * @min 0.0
+ * @max 10.0
+ * @increment 0.1
+ * @decimal 1
+ * @group VTOL Attitude Control
+ */
+PARAM_DEFINE_FLOAT(VT_UNLD_ALT_P, 2.0f);
+
+/**
+ * Controlled-unloading vertical-speed pitch damping
+ *
+ * Positive NED vertical speed (descent) commands positive pitch; negative
+ * vertical speed (climb) commands negative pitch.
+ *
+ * @min 0.0
+ * @max 10.0
+ * @increment 0.1
+ * @decimal 1
+ * @group VTOL Attitude Control
+ */
+PARAM_DEFINE_FLOAT(VT_UNLD_VZ_D, 2.0f);
+
+/**
+ * Minimum pitch during a controlled-unloading hold
+ *
+ * @unit deg
+ * @min -20.0
+ * @max 0.0
+ * @increment 0.5
+ * @decimal 1
+ * @group VTOL Attitude Control
+ */
+PARAM_DEFINE_FLOAT(VT_UNLD_P_MIN, -12.0f);
+
+/**
+ * Maximum pitch during a controlled-unloading hold
+ *
+ * @unit deg
+ * @min 0.0
+ * @max 20.0
+ * @increment 0.5
+ * @decimal 1
+ * @group VTOL Attitude Control
+ */
+PARAM_DEFINE_FLOAT(VT_UNLD_P_MAX, 10.0f);
+
+/**
+ * Transition-allocation lambda at which fixed-wing attitude authority starts
+ *
+ * While a fresh external transition-allocation command is active, lambda
+ * synchronously allocates lift-rotor collective and MC/FW attitude authority.
+ * Below this value attitude control remains fully multicopter-dominated.
+ * Stock airspeed blending remains the fail-safe fallback when the external
+ * command is absent or stale.
+ *
+ * @min 0.0
+ * @max 0.9
+ * @increment 0.01
+ * @decimal 2
+ * @group VTOL Attitude Control
+ */
+PARAM_DEFINE_FLOAT(VT_UNLD_W0, 0.10f);
+
+/**
+ * Transition-allocation lambda at which fixed-wing attitude authority is full
+ *
+ * Must be greater than VT_UNLD_W0.  Between the two thresholds the MC/FW
+ * attitude weights change linearly with the executed lambda command.
+ *
+ * @min 0.1
+ * @max 1.0
+ * @increment 0.01
+ * @decimal 2
+ * @group VTOL Attitude Control
+ */
+PARAM_DEFINE_FLOAT(VT_UNLD_W1, 0.90f);
